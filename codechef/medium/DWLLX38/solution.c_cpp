#include <stdio.h>

int main() {
    int weight = 70;// Declare a short variable for weight and assign it the value 70
    
    int height = 175;// Declare an integer variable for height and assign it the value 175
    
    printf("Height: %d\n", height);// Print: "Height: " followed by the value of height
    
    printf("Weight: %d", weight);// Print: "Weight: " followed by the value of weight

    return 0;
}
